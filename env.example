# --- Frontend (Next.js) ---
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# --- Backend (FastAPI) ---
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
DATABASE_URL=your_supabase_postgres_connection_string

# LLM providers — only one is required to start; keep both if you plan
# to A/B the explanation quality between Gemini and Claude
GEMINI_API_KEY=your_gemini_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# OCR fallback (optional — only needed if using Google Document AI
# instead of local Tesseract)
GOOGLE_DOCUMENT_AI_PROJECT_ID=
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# App config
ENVIRONMENT=development
MAX_UPLOAD_SIZE_MB=50
OCR_CONFIDENCE_THRESHOLD=60
